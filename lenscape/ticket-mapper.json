{"SchemaVersion":"1.0","ModelVersion":202,"Metadata":{"Title":"Ticket Mapper","Author":"Muse Testing","ProductIntent":"","CreatedAt":"2026-10-15T02:31:30.8040221+00:00","UpdatedAt":"2026-10-15T02:42:09.0449643+00:00","DefaultView":"system"},"Actors":[{"Id":"92e37c76-47e8-45c8-8256-9e10f04c7f55","Type":"actor","Name":"Raffle operator","Description":"Chooses a ticket number range, calls the generation endpoint, downloads and prints the DOCX. Coordinates issued ranges manually; no number ledger exists in the app.","Tags":[],"Properties":{"visualShape":"pill"},"References":[]},{"Id":"51a2881d-4672-46d4-8170-d11e74d60840","Type":"actor","Name":"Developer / maintainer","Description":"Edits ticket template and code, builds and tests, manages configuration and documentation. Template changes are file changes; no upload endpoint exists.","Tags":[],"Properties":{"visualShape":"pill"},"References":[]},{"Id":"a69bdabb-8385-4e71-be1f-0ba09e7b49a7","Type":"actor","Name":"Deployment operator","Description":"Provisions the runtime, configures secrets and logging, deploys and rolls back, manually cleans orphaned files.","Tags":[],"Properties":{"visualShape":"pill"},"References":[]},{"Id":"1cc25379-84bc-418c-87d9-c2475dc35aa9","Type":"actor","Name":"Drive account owner","Description":"Grants OAuth consent for Google Drive and can revoke credentials. Only relevant if the Drive client is resolved; the ticket route never uses it.","Tags":[],"Properties":{"visualShape":"pill"},"References":[]}],"Systems":[{"Id":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Type":"system","Name":"Ticket Mapper","Description":"ASP.NET Core 8 Web API that stamps an inclusive integer range onto a PNG ticket template and returns a Word document. Built for the Lake George Alumni Association fall 2023 raffle. No frontend, no sales database, no payment flow, no persisted number allocation.","Tags":[],"Properties":{},"References":[]},{"Id":"826fdc8e-375c-4f6b-a188-e3f5569d4744","Type":"system","Name":"Google OAuth / Drive","Description":"External Google account and Drive service. Adapter code exists and is DI-registered, but the ticket endpoint never calls it. No live grant or API call has been verified.","Tags":[],"Properties":{},"References":[]},{"Id":"90c07571-6894-48f2-8a54-0c48f5f3ebe5","Type":"system","Name":"Document viewer / print workflow","Description":"Manual downstream activity: the operator reviews and prints the downloaded DOCX outside the app. No viewer or printer integration exists.","Tags":[],"Properties":{},"References":[]}],"Containers":[{"SystemId":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Id":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Type":"container","Name":"API process","Description":"Single ASP.NET Core process hosting controllers, MediatR, ImageSharp rendering, file I/O, and the optional Drive adapter.","Tags":[],"Properties":{},"References":[]},{"SystemId":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Id":"93506f13-7969-4a47-99de-b9dd2acad510","Type":"container","Name":"RabbitMQ scaffold","Description":"RabbitMQ 3-management deployed by Docker Compose. No application producer, consumer, or queue code references it; it has no business edge to ticket generation.","Tags":[],"Properties":{},"References":[]}],"Components":[{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"b9433e4b-9d57-4324-b220-2500ef05ea8f","Type":"component","Name":"Program.cs startup","Description":"Application entry point. Configures DI, middleware, Swagger, Serilog, and the host lifecycle.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"05e0aa71-80e6-473a-8bd8-9db647f4a851","Type":"component","Name":"DocumentController","Description":"GET /api/v1/Document/DownloadDocument?startNumber=\u0026endNumber=. Orchestrates create, read, cleanup notification, and returns Tickets.docx.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"a7c18f17-764c-4bb7-a8db-a4631ec20724","Type":"component","Name":"TestController","Description":"GET /api/v1/Test/Hello returns \u0027Hi\u0027. Reachability probe only.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"ae074b56-9b41-4782-90ba-4edd92bc0ffd","Type":"component","Name":"MediatR wiring","Description":"In-process Send/Publish. Handlers registered as transient; all messaging is in-process, not a message bus.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"49acd1f6-4585-4c59-a8db-e98221c78953","Type":"component","Name":"CreateDocumentCommandHandler","Description":"Renders tickets: loads the PNG template, resolves Arial 30, clones the template per number, draws the number at (120,290), saves ticket_\u003Cn\u003E.png, embeds into DOCX, deletes the PNG. Uses ImageSharp, OpenXML and System.IO directly.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"bba9cec9-7c16-49f7-b652-df9ede70da27","Type":"component","Name":"GetDocumentQueryHandler","Description":"Reads the complete DOCX into a byte array via the filesystem abstraction. Rethrows errors; does not forward the cancellation token.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"0698d1bc-a73b-4935-adfc-ad1b9a685fc1","Type":"component","Name":"TimeToDeleteNotificationHandler","Description":"Consumes the in-process TimeToDeleteNotification and sends a DeleteDocumentCommand. This is an in-process MediatR notification, not a message-bus event.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"f6822f99-3feb-4ae0-8680-7484aecdca90","Type":"component","Name":"DeleteDocumentCommandHandler","Description":"Best-effort file delete plus existence check via the filesystem abstraction. Swallows errors after logging.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"2ccad9b5-60c8-44ca-b707-003838bae390","Type":"component","Name":"IFileSystem abstraction","Description":"Read/delete abstraction used by the get and delete handlers only. The create handler bypasses it with direct file I/O.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"136bb940-fb87-48d9-9e05-9717fbc63bd9","Type":"component","Name":"GoogleDrive adapter","Description":"Upload, download, delete, list, and metadata operations against Google Drive. Implemented but unused: no ticket-route caller exists.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"5c769925-5a7d-4045-bc44-eece868dc3ea","Type":"component","Name":"DriveService factory \u002B OAuth","Description":"Loads client_secrets.json, requests full Drive scope, fixed user key, on-disk token cache. Blocks on .Result.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"1da00993-c695-4542-ac85-b01fce6e6c2b","Type":"component","Name":"Settings binder","Description":"Binds user-secrets and environment variables. The checked-in appsettings.json is NOT loaded.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"ec3145c2-9486-4060-a269-a1bc3d50913c","Type":"component","Name":"Serilog config","Description":"Logging configuration. The active sink is unverified.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"de11b899-5ff4-49ce-8336-c9fdb428e579","Type":"component","Name":"GoogleDriveRepository","Description":"Placeholder repository boundary. Injects the Drive adapter but exposes no business methods.","Tags":[],"Properties":{},"References":[]},{"ContainerId":"86d93470-dc28-4368-8c3e-c78cfb2abc95","Id":"d026fbae-eeed-46ca-b92b-3df68e3102eb","Type":"component","Name":"FileIO project","Description":"Empty infrastructure project; not referenced by the solution.","Tags":[],"Properties":{},"References":[]}],"ExternalDependencies":[{"Id":"724a0085-f968-47f2-ae54-1c7a0e4ae493","Type":"external-dependency","Name":"NuGet packages","Description":"MediatR 11.1, ImageSharp 3.0.1, DocumentFormat.OpenXml 3.0, System.IO.Abstractions 20.0.4, Google.Apis.Drive.v3, Serilog 3.1.1, Swashbuckle 6.5. No lock file; no dependency audit.","Tags":[],"Properties":{},"References":[]},{"Id":"2c533730-10ee-441f-9efa-4ca0c3084301","Type":"external-dependency","Name":"Ticket.png template","Description":"Source PNG ticket template. Numbers are stamped at coordinates (120,290) in Arial 30.","Tags":[],"Properties":{},"References":[]}],"Relationships":[{"Id":"b6b3d8a7-d836-467c-86b3-2297df453d2c","SourceId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","TargetId":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Kind":"sync","Label":"Generates tickets (uses; HTTP)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"2f85aefd-96c8-488d-952c-c39a98d06894","SourceId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","TargetId":"90c07571-6894-48f2-8a54-0c48f5f3ebe5","Kind":"sync","Label":"Reviews and prints (uses; manual)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"abf321dd-a63c-47ae-a95a-e25bb7e86579","SourceId":"51a2881d-4672-46d4-8170-d11e74d60840","TargetId":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Kind":"sync","Label":"Maintains source and template (uses; manual)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"2a44d515-d05b-4673-9134-70a56affaf32","SourceId":"a69bdabb-8385-4e71-be1f-0ba09e7b49a7","TargetId":"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18","Kind":"sync","Label":"Deploys and configures (uses; manual)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"7d4d46d1-7c74-4b0e-a28c-fecd38ccad58","SourceId":"1cc25379-84bc-418c-87d9-c2475dc35aa9","Ta