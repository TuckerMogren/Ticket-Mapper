"sync","Label":"Authenticates via (uses)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"b61c691c-246c-46c3-8908-ede7601e871a","SourceId":"b9433e4b-9d57-4324-b220-2500ef05ea8f","TargetId":"ae074b56-9b41-4782-90ba-4edd92bc0ffd","Kind":"sync","Label":"Registers (uses)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"260c9fe1-abb0-43a4-84f8-371252991a1d","SourceId":"b9433e4b-9d57-4324-b220-2500ef05ea8f","TargetId":"1da00993-c695-4542-ac85-b01fce6e6c2b","Kind":"sync","Label":"Binds configuration (uses)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]},{"Id":"41ef1682-7eb9-41c2-a473-5fd462697ea4","SourceId":"de11b899-5ff4-49ce-8336-c9fdb428e579","TargetId":"136bb940-fb87-48d9-9e05-9717fbc63bd9","Kind":"sync","Label":"Injects (placeholder) (uses)","Description":"","Direction":"outbound","Technology":"","Tags":[],"Properties":{},"References":[]}],"Flows":[{"Id":"82b7ea7f-efa2-4fd3-8309-4bbd3d9ef721","Name":"Ticket generation and cleanup","Description":"Operator requests a number range; the API renders each ticket, assembles the DOCX, returns it, then deletes the server-side file.","Intent":"","Tags":[],"Properties":{},"Steps":[{"Id":"51258195-40bf-44d5-825a-02cc940c4485","Order":1,"ActorId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","SourceId":null,"TargetId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","RelationshipId":null,"Label":"Request ticket range","Description":"Operator calls GET /api/v1/Document/DownloadDocument with startNumber and endNumber.","Intent":null,"Verification":"needs-review","References":null},{"Id":"62416fa1-3a01-4b3a-8397-97e74c41075b","Order":2,"ActorId":null,"SourceId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","TargetId":"49acd1f6-4585-4c59-a8db-e98221c78953","RelationshipId":null,"Label":"Dispatch create command","Description":"Controller builds ticket details and sends CreateDocumentCommand via MediatR.","Intent":null,"Verification":"needs-review","References":null},{"Id":"42a46d74-6575-4b46-8caf-a9bb02dde6b6","Order":3,"ActorId":null,"SourceId":"49acd1f6-4585-4c59-a8db-e98221c78953","TargetId":"2c533730-10ee-441f-9efa-4ca0c3084301","RelationshipId":"ea437987-6454-44a6-8c0e-8f04688fc956","Label":"Render tickets","Description":"Handler clones the PNG template per number, draws the number, embeds each PNG into the DOCX, deletes the PNG.","Intent":null,"Verification":"needs-review","References":null},{"Id":"db4fca85-eade-43b7-b1d0-f3e56ddeed64","Order":4,"ActorId":null,"SourceId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","TargetId":"bba9cec9-7c16-49f7-b652-df9ede70da27","RelationshipId":null,"Label":"Read DOCX bytes","Description":"Controller reads the complete DOCX into memory via the get handler.","Intent":null,"Verification":"needs-review","References":null},{"Id":"ccfa1ce2-ff5e-43d4-a2c6-8d2464e532a9","Order":5,"ActorId":null,"SourceId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","TargetId":"0698d1bc-a73b-4935-adfc-ad1b9a685fc1","RelationshipId":null,"Label":"Publish cleanup notification","Description":"Controller publishes the in-process TimeToDeleteNotification.","Intent":null,"Verification":"needs-review","References":null},{"Id":"4edd6944-3e48-4f24-9431-e2448322ca58","Order":6,"ActorId":null,"SourceId":"0698d1bc-a73b-4935-adfc-ad1b9a685fc1","TargetId":"f6822f99-3feb-4ae0-8680-7484aecdca90","RelationshipId":null,"Label":"Delete server file","Description":"Notification handler sends DeleteDocumentCommand; the handler best-effort deletes the DOCX.","Intent":null,"Verification":"needs-review","References":null},{"Id":"5131fffc-860f-412b-be58-507ee6b38ac5","Order":7,"ActorId":null,"SourceId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","TargetId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","RelationshipId":null,"Label":"Return Tickets.docx","Description":"Controller returns HTTP 200 with the buffered document.","Intent":null,"Verification":"needs-review","References":null}]},{"Id":"85b254ab-64b1-4ebc-8e63-9e0eafb9ba2c","Name":"Rendering or read failure","Description":"Per-ticket exceptions are caught and logged while the loop continues, so a 200 response can carry an incomplete document.","Intent":"","Tags":[],"Properties":{},"Steps":[{"Id":"f2c49665-1abf-424c-b3b9-4ea024be60ae","Order":1,"ActorId":null,"SourceId":"49acd1f6-4585-4c59-a8db-e98221c78953","TargetId":null,"RelationshipId":null,"Label":"Ticket render throws","Description":"A per-ticket exception is caught, logged, and the loop continues with the next number.","Intent":null,"Verification":"needs-review","References":null},{"Id":"ee79422d-2064-4937-9f8c-20df7f404713","Order":2,"ActorId":null,"SourceId":"05e0aa71-80e6-473a-8bd8-9db647f4a851","TargetId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","RelationshipId":null,"Label":"Incomplete DOCX returned as 200","Description":"The assembled document may be missing tickets but is still returned successfully.","Intent":null,"Verification":"needs-review","References":null},{"Id":"2fd92c13-596e-424e-a213-a42544485762","Order":3,"ActorId":null,"SourceId":"bba9cec9-7c16-49f7-b652-df9ede70da27","TargetId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","RelationshipId":null,"Label":"Read failure becomes 500","Description":"If the DOCX cannot be read, the get handler rethrows and the controller returns 500.","Intent":null,"Verification":"needs-review","References":null}]},{"Id":"7526eb2b-6240-4bac-82fc-f71211cad2a6","Name":"Request cancellation","Description":"The render loop has no explicit cancellation check; a disconnected client may receive no response.","Intent":"","Tags":[],"Properties":{},"Steps":[{"Id":"1eaba542-b667-4dd0-9549-d3c9ecb85a08","Order":1,"ActorId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","SourceId":null,"TargetId":"49acd1f6-4585-4c59-a8db-e98221c78953","RelationshipId":null,"Label":"Client disconnects mid-render","Description":"No explicit cancellation check exists in the ticket loop.","Intent":null,"Verification":"needs-review","References":null},{"Id":"4c5d1c02-269d-4c6f-aff9-5a3364896417","Order":2,"ActorId":null,"SourceId":"49acd1f6-4585-4c59-a8db-e98221c78953","TargetId":"92e37c76-47e8-45c8-8256-9e10f04c7f55","RelationshipId":null,"Label":"Cancellation surfaces as 400/500","Description":"Escaped cancellation maps to 400; other failures to 500.","Intent":null,"Verification":"needs-review","References":null}]},{"Id":"5a4fe923-9248-44f4-a081-29fc5820ac61","Name":"Cleanup failure leaves orphans","Description":"The delete handler swallows failures after logging; PNG orphans from render errors are never cleaned.","Intent":"","Tags":[],"Properties":{},"Steps":[{"Id":"4d4fd59c-6149-417b-afa0-dfa138289b5a","Order":1,"ActorId":null,"SourceId":"f6822f99-3feb-4ae0-8680-7484aecdca90","TargetId":"2ccad9b5-60c8-44ca-b707-003838bae390","RelationshipId":"80aacf42-285a-41d6-83b3-e586d4cc5641","Label":"Delete fails silently","Description":"DeleteDocumentCommandHandler logs the failure and swallows it.","Intent":null,"Verification":"needs-review","References":null},{"Id":"25955c0d-bf5d-403b-ae93-7778ebac1dce","Order":2,"ActorId":null,"SourceId":"49acd1f6-4585-4c59-a8db-e98221c78953","TargetId":"a69bdabb-8385-4e71-be1f-0ba09e7b49a7","RelationshipId":null,"Label":"Orphan PNGs accumulate","Description":"Intermediate PNGs from failed renders are never removed by the DOCX cleanup path.","Intent":null,"Verification":"needs-review","References":null}]}],"Views":{"75907f36-aac4-4ded-b0a5-f8fe4ba7ad18":{"Position":{"X":160,"Y":120},"ScopedPositions":{"system:global":{"X":160,"Y":120}}},"826fdc8e-375c-4f6b-a188-e3f5569d4744":{"Position":{"X":440,"Y":120},"ScopedPositions":{"system:global":{"X":440,"Y":120}}},"90c07571-6894-48f2-8a54-0c48f5f3ebe5":{"Position":{"X":720,"Y":120},"ScopedPositions":{"system:global":{"X":720,"Y":120}}},"92e37c76-47e8-45c8-8256-9e10f04c7f55":{"Position":{"X":1000,"Y":120},"ScopedPositions":{"system:global":{"X":1000,"Y":120}}},"51a2881d-4672-46d4-8170-d11e74d60840":{"Position":{"X":160,"Y":